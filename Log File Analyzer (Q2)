import pandas as pd

report = {}

with open("application.log", "r") as file:
    lines = file.readlines()

for line in lines:
    parts = line.strip().split()

    if len(parts) < 4:
        continue

    level = parts[2]
    module = parts[3]

    if level in ["ERROR", "WARNING"]:

        if module not in report:
            report[module] = {
                "ERROR": 0,
                "WARNING": 0
            }

        report[module][level] += 1

df = pd.DataFrame(report).T
df.reset_index(inplace=True)
df.rename(columns={"index": "Module"}, inplace=True)

df.to_csv("error_report.csv", index=False)

print(df)
print("\nReport saved as error_report.csv")